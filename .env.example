# LLM provider: mock (offline, deterministic, default) | openai (any OpenAI-compatible API: OpenAI, Groq, Ollama)
DATASAGE_PROVIDER=mock
DATASAGE_LLM_BASE_URL=https://api.openai.com/v1
DATASAGE_LLM_API_KEY=
DATASAGE_LLM_MODEL=gpt-4o-mini
# Query guardrails
DATASAGE_MAX_ROWS=500
DATASAGE_QUERY_TIMEOUT_MS=2000

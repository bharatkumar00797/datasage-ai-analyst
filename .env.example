# LLM provider: mock (offline, deterministic, default) | openai (any OpenAI-compatible API: OpenAI, Groq, Ollama)
DATASAGE_PROVIDER=mock
DATASAGE_LLM_BASE_URL=https://api.openai.com/v1
DATASAGE_LLM_API_KEY=
DATASAGE_LLM_MODEL=gpt-4o-mini
# Query guardrails
DATASAGE_MAX_ROWS=500
DATASAGE_QUERY_TIMEOUT_MS=2000
# HTTP service (`datasage serve`, Docker, serverless)
# Comma-separated API keys; when unset the server is a public demo (mock provider only)
DATASAGE_API_KEYS=
# No auth + full access; localhost only
DATASAGE_DEV_MODE=false
DATASAGE_CORS_ORIGINS=
DATASAGE_RATE_LIMIT_PER_MINUTE=120
DATASAGE_ASK_LIMIT_PER_MINUTE=30
DATASAGE_UPLOAD_LIMIT_PER_MINUTE=10
# Use the right-most X-Forwarded-For hop (only behind a proxy you trust)
DATASAGE_TRUST_PROXY=false
DATASAGE_MAX_WORKSPACES=200
DATASAGE_MAX_UPLOADS=5
